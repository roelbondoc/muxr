#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "muxr"
require "fileutils"
require "rbconfig"
require "socket"

if ARGV.include?("-v") || ARGV.include?("--version")
  puts "muxr #{Muxr::VERSION}"
  exit 0
end

if ARGV.include?("-l") || ARGV.include?("--list")
  names = Muxr::Application.list_active
  puts names.join("\n") unless names.empty?
  exit 0
end

install_skill_arg = ARGV.find { |a| a == "--install-skill" || a.start_with?("--install-skill=") }

if install_skill_arg
  requested_strategy = install_skill_arg.split("=", 2)[1]
  unless [nil, "copy", "link"].include?(requested_strategy)
    $stderr.puts "muxr: --install-skill takes `copy` or `link` (got #{requested_strategy.inspect})"
    exit 1
  end
  src = File.expand_path("../skills/muxr-control", __dir__)
  unless File.directory?(src)
    $stderr.puts "muxr: skill source not found at #{src} (was the gem packaged without skills/?)"
    exit 1
  end
  running_from_source_checkout = File.directory?(File.expand_path("../.git", __dir__))
  strategy = requested_strategy || (running_from_source_checkout ? "link" : "copy")
  claude_skills = File.expand_path("~/.claude/skills")
  dst = File.join(claude_skills, "muxr-control")
  FileUtils.mkdir_p(claude_skills)
  FileUtils.rm_rf(dst) if File.symlink?(dst) || File.exist?(dst)
  if strategy == "link"
    FileUtils.ln_s(src, dst)
  else
    FileUtils.mkdir_p(dst)
    FileUtils.cp_r(File.join(src, "."), dst)
  end

  # Pick the most stable absolute path we can point claude's mcp config at:
  #
  #  - Installed gem: $GEM_HOME/bin/muxr-mcp is a wrapper bin stub that
  #    survives version upgrades (RubyGems repoints it on `gem update`).
  #    Always prefer it when present.
  #  - Source checkout: no bin stub exists; fall back to the script that
  #    sits next to the running `muxr` binary.
  bin_stub = File.join(Gem.bindir, "muxr-mcp") rescue nil
  bridge = (bin_stub && File.exist?(bin_stub)) ? bin_stub : File.expand_path("muxr-mcp", __dir__)
  puts(
    if strategy == "link"
      <<~LINKED
        ✓ Linked skill: #{dst}
                     -> #{src}

        Edits to the skill are live in new claude sessions with no re-run.
        Force a copy instead with `muxr --install-skill=copy`.
      LINKED
    else
      <<~COPIED
        ✓ Copied skill to: #{dst}
          (source: #{src})

        Re-run `muxr --install-skill` after `gem update muxr` to refresh the
        skill contents. An installed gem is copied rather than linked because
        RubyGems prunes the old versioned gem directory on upgrade, which
        would leave a symlink dangling. If you know this path is stable, force
        a symlink with `muxr --install-skill=link`.
      COPIED
    end
  )
  puts
  puts <<~MSG
    Next, register the muxr MCP bridge with Claude Code at USER scope
    (so every claude session sees it, not just ones started from your
    home directory):

        claude mcp add muxr #{bridge} --scope user

    If you omit `--scope user`, `claude mcp add` defaults to local scope
    and the MCP is only loaded when claude starts from your current cwd —
    a common first-run gotcha.

    If your gem bin directory is on $PATH, `muxr-mcp` works as a bare name too:

        claude mcp add muxr muxr-mcp --scope user

    Then restart any running Claude Code sessions so they pick up the new
    config. Any claude you launch from inside muxr — a tiled pane or the
    Claude drawer (Ctrl-a C) — auto-detects its session via MUXR_SESSION /
    MUXR_CONTROL_SOCKET, which muxr injects into every PTY it spawns.
    Outside muxr the bridge stays quiet and offers no tools.

    Panes that were already running before this install won't have those
    vars — open a new pane (Ctrl-a c) to pick them up.
  MSG
  exit 0
end

if ARGV.include?("-h") || ARGV.include?("--help")
  puts <<~USAGE
    muxr #{Muxr::VERSION} — a tiling terminal multiplexer

    Usage:
      muxr                 attach the session for the current directory (auto-spawn if needed)
      muxr <name>          attach (or start) the named session
      muxr -s <name>       same as above
      muxr --list          list running sessions and exit
      muxr --install-skill install the MCP skill into ~/.claude/skills and exit
                           (symlinks from a source checkout, copies from an
                            installed gem; force with --install-skill=copy|link)
      muxr --version       print version and exit
      muxr --help          this help

    Keybindings (Ctrl-a prefix):
      C-a c   new pane            C-a n / p   next / prev pane
      C-a a   toggle last pane    C-a 1..9    jump to pane by number
      C-a x   close pane          C-a Tab     cycle layout
      C-a ~   toggle drawer       C-a Enter   promote to master
      C-a C   Claude drawer       (as is claude in any pane; needs `muxr --install-skill`)
      C-a :   command prompt      C-a ?       toggle help
      C-a d   detach (server stays running)
      C-a q   kill session (with y/n confirmation)
      C-a C-a send literal C-a
  USAGE
  exit 0
end

# Internal: run as the server process. bin/muxr fork-execs itself with this
# flag when no server is alive for the requested session.
if ARGV.include?("--server")
  args = ARGV.reject { |a| a == "--server" }
  # Detach from the controlling terminal so the server survives the parent's
  # shell closing. nochdir=true preserves cwd (the first pane inherits it);
  # noclose=true keeps the stdin/out/err redirections Process.spawn set up.
  begin
    Process.daemon(true, true)
  rescue NotImplementedError
    # Platforms without Process.daemon (rare on POSIX) just run inline.
  end
  begin
    Muxr::Application.new(args).run
  rescue => e
    $stderr.puts "muxr server: #{e.class}: #{e.message}"
    $stderr.puts e.backtrace.first(20).join("\n")
    exit 1
  end
  exit 0
end

# ---- client mode (the default) ----

def session_name_from(argv)
  idx = argv.index("-s") || argv.index("--session")
  return argv[idx + 1] if idx && argv[idx + 1]
  argv.find { |a| !a.start_with?("-") } || Muxr::Application.default_session_name
end

def probe_socket(path)
  return :missing unless File.exist?(path)
  begin
    UNIXSocket.new(path).close
    :alive
  rescue Errno::ECONNREFUSED, Errno::ENOENT
    File.unlink(path) rescue nil
    :stale
  rescue Errno::EACCES
    :forbidden
  end
end

def spawn_server(name, log_path)
  FileUtils.mkdir_p(File.dirname(log_path))
  log = File.open(log_path, "a")
  pid = Process.spawn(
    RbConfig.ruby, __FILE__, "--server", name,
    in:  "/dev/null",
    out: log,
    err: log,
    pgroup: true
  )
  log.close
  Process.detach(pid)
  pid
end

def wait_for_socket(path, deadline)
  until File.exist?(path)
    return false if Time.now >= deadline
    sleep 0.05
  end
  true
end

name = session_name_from(ARGV)
socket_path = Muxr::Application.socket_path_for(name)

case probe_socket(socket_path)
when :forbidden
  $stderr.puts "muxr: cannot access #{socket_path} (permission denied)"
  exit 1
when :alive
  # great — attach.
when :missing, :stale
  log_path = File.join(Dir.home, ".muxr", "logs", "#{name}.log")
  spawn_server(name, log_path)
  unless wait_for_socket(socket_path, Time.now + 3.0)
    $stderr.puts "muxr: server did not start within 3s (see #{log_path})"
    exit 1
  end
end

client = Muxr::Client.new(name)
begin
  client.connect
rescue Errno::ECONNREFUSED, Errno::ENOENT => e
  $stderr.puts "muxr: cannot connect to server at #{socket_path}: #{e.message}"
  exit 1
end
exit(client.run || 0)
